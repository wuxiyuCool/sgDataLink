# ---------------------------------------------------------------------------
# DataBridge 管理后端（node-express-boilerplate 扩展）
# 复制为 .env 后按需修改；MEM_MOCK=true 时只需要本文件里的变量即可启动。
# ---------------------------------------------------------------------------

# development | production | test （必填，无默认值）
NODE_ENV=development

# Port number（DataBridge 契约默认 3001）
PORT=3001

# 内存 mock 开关：true = 完全不连数据库，用 src/repositories 内存仓储 + 种子数据
#                 false = 走脚手架原逻辑，连 MongoDB 后再 listen
MEM_MOCK=true

# Go 同步引擎地址：Node 下发 start / stop 指令的前缀
ENGINE_BASE_URL=http://127.0.0.1:8080

# 引擎回报本服务的地址（POST /api/v1/engine/report、/api/v1/engine/logs）
# 容器内用服务名，如 http://databridge-admin:3001/api/v1/engine
ADMIN_REPORT_URL=http://127.0.0.1:3001/api/v1/engine

# 调用引擎的超时（毫秒）
ENGINE_TIMEOUT_MS=5000

# ---------------------------------------------------------------------------
# 持久层驱动（DataBridge 第二阶段）
# DB_DRIVER=memory（默认）：完全不连库，用 src/repositories 内存仓储 + 种子数据；
# DB_DRIVER=mysql         ：走 src/repositories/mysql/*.store.js 真实落库，
#                           启动时逐表 CREATE TABLE IF NOT EXISTS（utf8mb4），
#                           且只在 databridge_datasource 为空表时注入一次种子。
# 与 MEM_MOCK 互不影响：mysql 模式下 MEM_MOCK 仍可为 true，表示「不连 MongoDB」。
# ---------------------------------------------------------------------------
DB_DRIVER=memory
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=dataLink
# 连接池大小与建连超时
MYSQL_CONNECTION_LIMIT=10
MYSQL_CONNECT_TIMEOUT_MS=10000

# URL of the Mongo DB —— MEM_MOCK=true 时可以留空
MONGODB_URL=

# JWT
# JWT secret key —— mock 阶段可省略，默认 databridge-mock-secret
JWT_SECRET=thisisasamplesecret
# Number of minutes after which an access token expires
JWT_ACCESS_EXPIRATION_MINUTES=30
# Number of days after which a refresh token expires
JWT_REFRESH_EXPIRATION_DAYS=30
# Number of minutes after which a reset password token expires
JWT_RESET_PASSWORD_EXPIRATION_MINUTES=10
# Number of minutes after which a verify email token expires
JWT_VERIFY_EMAIL_EXPIRATION_MINUTES=10

# SMTP configuration options for the email service
# For testing, you can use a fake SMTP service like Ethereal: https://ethereal.email/create
SMTP_HOST=email-server
SMTP_PORT=587
SMTP_USERNAME=email-server-username
SMTP_PASSWORD=email-server-password
EMAIL_FROM=support@yourapp.com
