# ============================================================================
# DataBridge 生产部署配置（docker compose 自动读取与本文件同目录的 .env 做变量替换）
# 用法：cp .env.example .env，填好 MYSQL_PASSWORD 等真实值后：
#   docker compose up -d --build
# 不创建 .env 时按默认值运行 = memory 演示模式（全是 mock 数据）。
# 注意：本目录 .env 只喂 compose；Node 容器内进程读的是 compose 注入的环境变量，
#      裸机部署才需要 node-express-boilerplate/.env（见该目录 .env.example）。
# ============================================================================

# ---- 持久层驱动：生产必须设为 mysql ----
DB_DRIVER=mysql

# ---- 平台元数据 MySQL（10+ 张 databridge_* 表，容器启动自动建表）----
MYSQL_HOST=10.45.34.222
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=dataLink
MYSQL_CONNECTION_LIMIT=10
