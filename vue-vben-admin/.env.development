# Whether to open mock
VITE_USE_MOCK = true

# public path
VITE_PUBLIC_PATH = /

# Cross-domain proxy, you can configure multiple
# Please note that no line breaks
# /api/v1 -> DataBridge 管理后端（node-express-boilerplate，默认 3001）
# 注意：createProxy 会把命中的前缀 rewrite 掉，因此 target 需要带上后端的 /api/v1 前缀
VITE_PROXY = [["/basic-api","http://localhost:3000"],["/upload","http://localhost:3300/upload"],["/api/v1","http://127.0.0.1:3001/api/v1"]]
# VITE_PROXY=[["/api","https://vvbin.cn/test"]]

# Delete console
VITE_DROP_CONSOLE = false

# Basic interface address SPA
# vben 自身的登录/用户信息接口由 mock 服务提供（/basic-api/*），不要改动该项；
# DataBridge 业务接口使用下面的独立前缀，见 src/api/databridge/http.ts
VITE_GLOB_API_URL=/basic-api

# DataBridge 接口前缀：dev 走上面的 vite proxy，prod 由 nginx 反向代理到 databridge-admin:3001
VITE_GLOB_DATABRIDGE_API_URL=/api/v1

# File upload address， optional
VITE_GLOB_UPLOAD_URL=/upload

# Interface prefix
VITE_GLOB_API_URL_PREFIX=
