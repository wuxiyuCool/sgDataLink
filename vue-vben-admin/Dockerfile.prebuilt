# 预构建前端镜像：不在容器内跑 pnpm（内网构建 1600 包太慢的替代方案）
# 用法：本地 `pnpm build` 后把 dist/* 传到本目录的 prebuilt-dist/，
#      再用 PREBUILT_WEB=1 bash deploy/build-push-harbor.sh 打包
FROM nginx:alpine

COPY prebuilt-dist /usr/share/nginx/html
COPY build/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
